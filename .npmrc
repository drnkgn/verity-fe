# @mui/material-nextjs@6.1.9's peerDependencies range for `next` only lists
# ^13/^14/^15, not yet 16 (this project pins next@16.3.4). The package's
# AppRouterCacheProvider works fine against Next 16 in practice — the peer
# range just hasn't been bumped upstream. legacy-peer-deps avoids failing
# `npm install` on that stale peer range without touching anything else.
legacy-peer-deps=true
